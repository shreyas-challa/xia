# A matrix is just an array of arrays. Elements are ARC-managed: the outer
# array owns each row, and dropping it releases every row.

fn row(a: int, b: int, c: int) -> [int]:
    let r: [int] = []
    push(r, a)
    push(r, b)
    push(r, c)
    return r

fn main() -> int:
    let grid: [[int]] = []
    push(grid, row(1, 2, 3))
    push(grid, row(4, 5, 6))
    push(grid, row(7, 8, 9))

    # Read the diagonal.
    let i = 0
    let trace = 0
    for r in grid:
        trace = trace + r[i]
        i = i + 1
    print(trace)

    # Mutate a nested element in place.
    grid[1][2] = 60
    print(grid[1][2])

    # Iterate rows and sum each.
    for r in grid:
        let s = 0
        for x in r:
            s = s + x
        print(s)
    return 0
